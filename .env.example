APP_NAME="Crawford Professionals Institute"
APP_URL=https://crawfordinstitute.online
APP_DEBUG=false
APP_TIMEZONE=Africa/Kampala

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpi_live
DB_USERNAME=cpi_user
DB_PASSWORD=

# SMTP — leave MAIL_HOST empty to fall back to PHP mail()
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@crawfordinstitute.online
MAIL_FROM_NAME="Crawford Professionals Institute"

# Africa's Talking SMS
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_ENV=production
