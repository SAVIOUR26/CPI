# Environment
.env

# Runtime-generated content — keep the folder structure, not the contents
storage/uploads/*
!storage/uploads/.gitkeep
storage/uploads/certificates/*
!storage/uploads/certificates/.gitkeep
storage/uploads/payment-proofs/*
!storage/uploads/payment-proofs/.gitkeep
storage/cache/*
!storage/cache/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
storage/certificates/*
!storage/certificates/.gitkeep

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local dev artifacts
*.log
/config/*
!/config/.gitkeep
